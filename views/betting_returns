CREATE OR REPLACE VIEW public.betting_returns
 AS
 SELECT abm.match,
    abm.matchday,
    abm.bet_type,
    rb1.outcome,
    abm.my_odds,
    abm.odds_1xbet,
    1::numeric / abm.odds_1xbet / (1::numeric / abm.odds_1xbet + 1::numeric / abm.odds_williamhill) AS normalized_probability,
    1::numeric / abm.my_odds - 1::numeric / abm.odds_1xbet AS edge,
        CASE
            WHEN (1::numeric / abm.my_odds - 1::numeric / abm.odds_1xbet) > 0.03 AND rb1.outcome = 0 THEN abm.odds_1xbet - 1::numeric
            WHEN (1::numeric / abm.my_odds - 1::numeric / abm.odds_1xbet) > 0.03 AND rb1.outcome = 1 THEN '-1'::integer::numeric
            ELSE 0::numeric
        END AS profit
   FROM active_betting_market abm
     JOIN raw_bet_1 rb1 ON abm.match = rb1.match AND abm.matchday = rb1.matchday
  WHERE abm.bet_type = 'HOME_WIN'::text;

ALTER TABLE public.betting_returns
    OWNER TO postgres;
